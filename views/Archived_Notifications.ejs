<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>

        Archived Notifications

    </title>

    <%- include('./CDN/bootstrap.ejs') %>

</head>

<body>

    <div class="d-flex">

        <%- include('./Header/Patient_Header.ejs') %>

            <div class="flex-grow-1 bg-light px-3 py-4 eyra-main-content">

                <div class="container-fluid">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h2 class="eyra-page-heading">

                            <!-- <i class="bi bi-archive-fill me-2"></i> -->

                            Archived Notifications

                        </h2>

                            <a href="javascript:void(0)" onclick="history.back()" class="eyra-btn-back eyra-floating-back">
                            
                                <i class="bi bi-arrow-left me-2"></i>
                            
                                Back
                            
                            </a>

                    </div>


                    <% if(notifications.length==0){ %>

                        <div class="eyra-empty-box">

                            <i class="bi bi-archive fs-1"></i>

                            <p class="mt-3 mb-0">

                                No archived notifications available

                            </p>

                        </div>

                        <% } %>


                            <% notifications.forEach((item)=>{ %>

                                <div class="eyra-notification-card eyra-archived mb-3">

                                    <div class="d-flex justify-content-between">

                                        <div>

                                            <h5 class="eyra-title">

                                                <%= item.title %>

                                                    <span class="badge bg-secondary ms-2">

                                                        Archived

                                                    </span>

                                            </h5>

                                        </div>

                                        <small class="text-muted">

                                            <%= new Date(item.created_at).toLocaleString('en-IN',
                                                {day:'2-digit',month:'short',year:'numeric',
                                                hour:'2-digit',minute:'2-digit'}) %>

                                        </small>

                                    </div>

                                    <p class="mt-2 mb-0">

                                        <%= item.message %>

                                    </p>

                                </div>

                                <% }) %>

                </div>

            </div>

    </div>

    <%- include('chat/chat.ejs') %>
        <%- include('./CDN/javascript.ejs') %>

</body>

</html>