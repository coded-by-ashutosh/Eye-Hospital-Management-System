<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        Patient Details
    </title>

    <%- include('../CDN/bootstrap.ejs') %>

</head>

<body>

    <div class="d-flex">

        <%- include('../Header/Doctor_Header.ejs') %>

            <div class="flex-grow-1 bg-light px-3 py-4 eyra-main-content">

                <div class="container-fluid">

                  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="view-users-heading fw-bold mb-1">

            Patient Profile

        </h1>

        <p class="text-muted mb-0">

            View patient information, medical history, consultation records, and previous prescriptions.

        </p>

    </div>

    <a href="javascript:void(0)"
       onclick="history.back()"
       class="eyra-btn-back">

        <i class="bi bi-arrow-left me-2"></i>

        Back

    </a>

</div>  

                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden mt-5">

                <div class="card-body p-5">

                    <div class="row">

                        <!-- LEFT SIDE -->

                        <div class="col-lg-4 text-center border-end">

                                <img src="/public/Patients_Photo/<%= patient_data.photo || 'default.png' %>" class="user-avatar">

                                <h3 class="mt-4 mb-1 fw-bold profile-basic">

                                    <%= patient_data.name %>

                                </h3>

                            <p class="user-email mb-3 me-2">
                                <i class="bi bi-envelope-fill me-1"></i>
                                <%= patient_data.email %>
                            </p>

                        </div>



                                <div class="col-lg-8">
                        
                            <div class="row g-3">
                        
                                <div class="col-md-6">
                                    <div class="eyra-info-card">
                                        <div class="eyra-info-label">
                                            <i class="bi bi-phone-fill"></i>
                                            Mobile Number
                                        </div>
                        
                                        <div class="eyra-info-value">
                                            <%= patient_data.mobile || 'Not Available' %>
                                        </div>
                                    </div>
                                </div>
                        
                                <div class="col-md-6">
                                    <div class="eyra-info-card">
                                        <div class="eyra-info-label">
                                            <i class="bi bi-person-fill"></i>
                                            Gender
                                        </div>
                        
                                        <div class="eyra-info-value">
                                            <%= patient_data.gender || 'Not Available' %>
                                        </div>
                                    </div>
                                </div>
                        
                                <div class="col-md-6">
                                    <div class="eyra-info-card">
                                        <div class="eyra-info-label">
                                            <i class="bi bi-card-text"></i>
                                            Ayushman Card
                                        </div>
                        
                                        <div class="eyra-info-value">
                                            <%= patient_data.ayushmaan_card || 'Not Available' %>
                                        </div>
                                    </div>
                                </div>
                        
                                <div class="col-md-6">
                                    <div class="eyra-info-card">
                                        <div class="eyra-info-label">
                                            <i class="bi bi-calendar-check-fill"></i>
                                            Registration Date
                                        </div>
                        
                                        <div class="eyra-info-value">
                                            <%= new Date(patient_data.reg_date).toLocaleString( 'en-IN' , {day:'2-digit',month:'short',year:'numeric',
                                                hour:'2-digit',minute:'2-digit'}) %>
                                        </div>
                                    </div>
                                </div>
                        
                                <div class="col-12">
                                    <div class="eyra-large-card">
                                        <div class="eyra-info-label">
                                            <i class="bi bi-geo-alt-fill"></i>
                                            Address
                                        </div>
                        
                                        <div class="eyra-info-value">
                                            <%= patient_data.address || 'No address available' %>
                                        </div>
                                    </div>
                                </div>
                        
                                <div class="col-12">
                                    <div class="eyra-large-card">
                                        <div class="eyra-info-label">
                                            <i class="bi bi-heart-pulse-fill"></i>
                                            Disease History
                                        </div>
                        
                                        <div class="eyra-info-value">
                                            <%= patient_data.dis_history || 'No disease history available' %>
                                        </div>
                                    </div>
                                </div>
                        
                            </div>
                        
                        </div>

                                    
                                </div>

                            </div>

                    </div>

                      

       <div class="eyra-action-card mt-5">

    <h4 class="fw-bold mb-4">
        <i class="bi bi-clipboard2-pulse-fill me-2"></i>
        Consultation Actions
    </h4>

        <div class="table-responsive">

                                        <table class="table table-hover doctor-appointments-table align-middle">

                                            <thead class="table-light">

                                                <tr>

                                                    <th>Visit Date</th>

                                                    <th>Issue</th>

                                                    <th>Status</th>

                                                    <th>Next Visit</th>

                                                    <th>Prescription</th>

                                                </tr>

                                            </thead>

                                            <tbody>

                                                <% if(timeline_record.length> 0) { %>

                                                    <% timeline_record.forEach((data)=> { %>

                                                        <tr>

                                                            <td>
                                            <span class="badge date bg-primary">
                                                <%= data.preferred_date %>
                                            </span>
                                        </td>

                                                            <td>

                                                                <%= data.issue %>

                                                            </td>

                                                            <td>

                                                                <% if(data.status=="Completed" ) { %>

                                                                    <span class="eyra-status-completed">

                                                                        Completed

                                                                    </span>

                                                                    <% } else if(data.status=="Approved" ) { %>

                                                                        <span class="eyra-status-approved">

                                                                            Approved

                                                                        </span>

                                                                        <% } else if(data.status=="Visited" ) { %>

                                                                            <span class="eyra-status-visited">

                                                                                Visited

                                                                            </span>

                                                                            <% } else { %>

                                                                                <span
                                                                                    class="eyra-status-pending">

                                                                                    Pending

                                                                                </span>

                                                                                <% } %>

                                                            </td>

                                                            <td>

                                                                <% if(data.next_visit_date) { %>
                                                        <span class="badge date bg-primary">
                                                        <%= new Date(data.next_visit_date).toLocaleString('en-CA', {year:'numeric', month:'2-digit', day:'2-digit'
                                                            }).replace(',', ' |' ) %>
                                                        </span>

                                                                        <% } else { %>

                                                                            <span class="text-muted">

                                                                                N/A

                                                                            </span>

                                                                            <% } %>

                                                            </td>

                                                            <td>

                                                                <% if(data.prescription_id) { %>

                                                                    <a href="/doctor/view_prescription/<%= data.prescription_id %>"
                                                                        class="eyra-btn-view-user-sm">
                                                                    <i class="bi bi-eye-fill me-1"></i>
                                                                        View

                                                                    </a>

                                                                    <% } else { %>

                                                                        <span class="text-muted">

                                                                            Not Added

                                                                        </span>

                                                                        <% } %>

                                                            </td>

                                                        </tr>

                                                        <% }) %>

                                                            <% } else { %>

                                                                <tr>

                                                                    <td colspan="5" class="text-center text-muted py-4">

                                                                        No Medical Timeline Found

                                                                    </td>

                                                                </tr>

                                                                <% } %>

                                            </tbody>

                                        </table>

                                    </div>

    </div>

</div>

                

    <%- include('../CDN/javascript.ejs') %>

</body>

</html>