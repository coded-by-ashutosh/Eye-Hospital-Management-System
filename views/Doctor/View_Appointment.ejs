<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        Appointment Details
    </title>

    <%- include('../CDN/bootstrap.ejs') %>

</head>

<body>

    <div class="d-flex">

        <%- include('../Header/Doctor_Header.ejs') %>

        <div class="flex-grow-1 bg-light px-3 py-4 eyra-main-content">

            <div class="container-fluid">

             <div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="manage-appointments-heading fw-bold mb-1">

            Consultation Details

        </h1>

        <p class="text-muted mb-0">

            Review patient information, consultation status, symptoms and complete the treatment workflow.

        </p>

    </div>

    <a href="javascript:void(0)"
       onclick="history.back()"
       class="eyra-btn-back">

        <i class="bi bi-arrow-left me-2"></i>

        Back

    </a>

</div>


               <div class="eyra-appointment-card mt-5">

    <!-- Patient Header -->

    <div class="eyra-profile-header">

        <div>

            <h4 class="fw-bold mb-1 profile-basic">

                <%= appoint_data.name %>

            </h4>

            <p class="text-muted mb-0">

                Appointment ID :

                <strong>#<%= appoint_data.id %></strong>

            </p>

            <div class="mt-3">

                <% if(appoint_data.status=="Approved"){ %>

                    <span class="eyra-status-approved">

                        Approved

                    </span>

                <% } else if(appoint_data.status=="Visited"){ %>

                    <span class="eyra-status-visited">

                        Visited

                    </span>

                <% } else if(appoint_data.status=="Completed"){ %>

                    <span class="eyra-status-completed">

                        Completed

                    </span>

                <% } %>

            </div>

        </div>

    </div>



    <!-- Information Grid -->

    <div class="row g-4 mt-3">

        <div class="col-md-6">

            <div class="eyra-info-card">

                <div class="eyra-info-label">

                    <i class="bi bi-envelope-fill"></i>

                    Email

                </div>

                <h6><%= appoint_data.email %></h6>

            </div>

        </div>



        <div class="col-md-6">

            <div class="eyra-info-card">

                <div class="eyra-info-label">

                    <i class="bi bi-phone-fill"></i>

                    Mobile Number

                </div>

                <h6><%= appoint_data.phone %></h6>

            </div>

        </div>



        <div class="col-md-6">

            <div class="eyra-info-card">

                <div class="eyra-info-label">

                    <i class="bi bi-calendar-event-fill"></i>

                    Appointment Date

                </div>

                <h6><%= appoint_data.preferred_date %></h6>

            </div>

        </div>



        <div class="col-md-6">

            <div class="eyra-info-card">

                <div class="eyra-info-label">

                    <i class="bi bi-clock-fill"></i>

                    Preferred Time

                </div>

                <h6><%= appoint_data.prefer_time %></h6>

            </div>

        </div>



        <div class="col-md-6">

            <div class="eyra-info-card">

                <div class="eyra-info-label">

                    <i class="bi bi-person-badge-fill"></i>

                    Assigned Doctor

                </div>

                <h6>

                    <%= appoint_data.doctor_name %>

                </h6>

            </div>

        </div>



        <div class="col-md-6">

            <div class="eyra-info-card">

                <div class="eyra-info-label">

                    <i class="bi bi-geo-alt-fill"></i>

                    Address

                </div>

                <h6>

                    <%= appoint_data.address %>

                </h6>

            </div>

        </div>



        <!-- Symptoms -->

        <div class="col-12">

            <div class="eyra-large-card">

                <div class="eyra-info-label">

                    <i class="bi bi-heart-pulse-fill"></i>

                    Patient Issue

                </div>

                <div class="eyra-info-value">

                    <%= appoint_data.issue %>

                </div>

            </div>

        </div>



        <!-- Consultation Notes -->

        <!-- <div class="col-12">

            <div class="eyra-large-card">

                <div class="eyra-info-label">

                    <i class="bi bi-journal-medical"></i>

                    Consultation Notes

                </div>

                <div class="eyra-info-value">

                    No consultation notes available yet.

                </div>

            </div>

        </div> -->

    </div>



    <!-- Doctor Actions -->

<% if(appoint_data.status != "Completed"){ %>

<div class="eyra-action-card mt-4">

    <h4 class="fw-bold mb-4">
        <i class="bi bi-clipboard2-pulse-fill me-2"></i>
        Consultation Actions
    </h4>

    <% if(appoint_data.status=="Approved"){ %>

        <a href="/doctor/visit_appointment/<%= appoint_data.id %>"
           class="btn btn-warning"
           onclick="return confirm('Mark patient as visited?')">

            <i class="bi bi-person-check-fill me-2"></i>
            Mark As Visited

        </a>

    <% } %>

    <% if(appoint_data.status=="Visited"){ %>

        <a href="/doctor/write_prescription/<%= appoint_data.id %>"
           class="btn btn-success">

            <i class="bi bi-file-earmark-medical-fill me-2"></i>
            Write Prescription

        </a>

    <% } %>

</div>

<% } %>
 

            </div>

        </div>

    </div>

    <%- include('../Footer/Dashboard_Footer.ejs') %>

        <%- include('../CDN/javascript.ejs') %>

</body>

</html>