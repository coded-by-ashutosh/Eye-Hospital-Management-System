<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Doctor Dashboard</title>

    <%- include('../CDN/bootstrap.ejs') %>

</head>

<body>

    <div class="d-flex">

        <%- include('../Header/Doctor_Header.ejs') %>

            <div class="flex-grow-1 bg-light px-3 py-4 eyra-main-content">

                <div class="container-fluid">

                    
                    
                        <h1 class="admin-dashboard-heading fw-bold mb-4">
                    
                            Doctor Dashboard
                    
                        </h1>
                    
                        <!-- <p class="text-muted mb-4">
                    
                            Welcome back,
                            <strong><%= doctor_name %></strong><br>
                    
                            Here's your consultation summary for today.
                    
                        </p> -->
                                       

                    <div class="row g-4 mb-5">
                    
                        <div class="col-md-3">
                    
                            <div class="eyra-admin-stat-card bg-primary">
                                <div class="eyra-card-icon">
                                    <i class="bi bi-people-fill"></i>
                                </div>
                    
                                <h3>
                                    <%= assigned_appointments %>
                                </h3>
                    
                                <p>
                                    Assigned Patients
                                </p>
                    
                            </div>
                    
                        </div>

                        <div class="col-md-3">
                    
                            <div class="eyra-admin-stat-card bg-success">
                    <div class="eyra-card-icon">                    
                        <i class="bi bi-calendar2-check-fill"></i>                    
                    </div>
                                <h3>
                                    <%= today_appointments %>
                                </h3>
                    
                                <p>
                                    Today's Appointments
                                </p>
                    
                            </div>
                    
                        </div>
                    
                        <div class="col-md-3">
                    
                            <div class="eyra-admin-stat-card bg-info">
                                <div class="eyra-card-icon">
                                    <i class="bi bi-hourglass-split"></i>
                                </div>
                    
                                <h3>
                                    <%= pending_consultations %>
                                </h3>
                    
                                <p>
                                    Pending Consultations
                                </p>
                    
                            </div>
                    
                        </div>
                    
                        
                    
                        <div class="col-md-3">
                    
                            <div class="eyra-admin-stat-card bg-warning">
                                <div class="eyra-card-icon">
                                    <i class="bi bi-check2-circle"></i>
                                </div>
                    
                                <h3>
                                    <%= completed_consultations %>
                                </h3>
                    
                                <p>
                                    Completed Consultations
                                </p>
                    
                            </div>
                    
                        </div>
                    
                    </div>



                    <div class="row g-4 mb-5">

            <div class="col-lg-8">

    <div class="eyra-chart-box">


  

                <h4 class="mb-3">

                    <i class="bi bi-graph-up-arrow me-2"></i>

                    Consultation Trends
                
                </h4> 
                <canvas id="doctorChart"></canvas>

    </div>

</div>

<div class="col-lg-4">

    <div class="eyra-chart-box">

        <h4 class="mb-5">

            <i class="bi bi-pie-chart-fill me-2"></i>

            Consultation Summary

        </h4>

        <canvas id="summaryChart"></canvas>

    </div>

</div>

</div>
                    
                        
 
                        




<div class="row mt-5">

    <div class="col-lg-5">

        <div class="eyra-chart-box">

            <h4 class="mb-4">

                <i class="bi bi-calendar2-week-fill me-2"></i>

                Today's Schedule

            </h4>

            <% if(today_schedule.length>0){ %>

            <% today_schedule.forEach(item=>{ %>

<div class="d-flex justify-content-between align-items-center py-3 border-bottom">

    <!-- Left Side -->
    <div>

        <h5 class="fw-semibold mb-1">
            <i class="bi bi-person-fill text-primary me-2"></i>
            <%= item.name %>
        </h5>

        <div class="small text-muted">

            <span class="me-3">
                <i class="bi bi-clock me-1"></i>
                <%= item.prefer_time %>
            </span>

            <span>
                <i class="bi bi-clipboard2-pulse-fill me-1"></i>
                <%= item.issue %>
            </span>

        </div>

    </div>

    <!-- Right Side -->
    <div class="text-end">

        <% if(item.status=="Approved"){ %>

            <span class="eyra-status-approved">
                Approved
            </span>

        <% } else if(item.status=="Visited"){ %>

            <span class="eyra-status-visited">
                Visited
            </span>

        <% } else if(item.status=="Completed"){ %>

            <span class="eyra-status-completed">
                Completed
            </span>

        <% } %>

        <div class="mt-4">

            <a href="/doctor/view_appointment/<%= item.id %>"
               class="eyra-btn-view-user">

                <i class="bi bi-eye-fill me-1"></i>
                 View

            </a>

        </div>

    </div>

</div>

<% }) %>
            <% } else { %>

            <div class="text-center py-5">

                <i class="bi bi-calendar-x fs-1 text-muted"></i>

                <h6 class="mt-3 text-muted">

                    No appointments scheduled today.

                </h6>

            </div>

            <% } %>

        </div>

    </div>



                    

                </div>

            </div>

    </div>

    

    <%- include('../Footer/Dashboard_Footer.ejs') %>

        <%- include('../CDN/javascript.ejs') %>

        <script>

       const chartData =
<%- JSON.stringify(appointment_chart || []) %>;

 const consultationSummary =
<%- JSON.stringify(consultation_summary || {
    completed: 0,
    visited: 0,
    pending: 0
}) %>;

document.addEventListener("DOMContentLoaded", function () {

   


    const ctx = document
        .getElementById("doctorChart")
        .getContext("2d");

    new Chart(ctx, {

        type: "line",

        data: {

            labels: chartData.map(item => item.status),

            datasets: [

                {

                    label: "Appointments",

                    data: chartData.map(item => item.total),

                    borderColor: "#0D6EFD",

                    backgroundColor: "rgba(13,110,253,0.15)",

                    fill: true,

                    tension: 0.45,

                    borderWidth: 3,

                    pointRadius: 5,

                    pointHoverRadius: 7,

                    pointBackgroundColor: "#0D6EFD",

                    pointBorderColor: "#ffffff",

                    pointBorderWidth: 2

                }

            ]

        },

        options: {

            responsive: true,

            plugins: {

                legend: {

                    display: false

                }

            },

            scales: {

                y: {

                    beginAtZero: true,

                    ticks: {

                        precision: 0

                    },

                    grid: {

                        color: "rgba(0,0,0,.05)"

                    }

                },

                x: {

                    grid: {

                        display: false

                    }

                }

            }

        }

    });

});

const summaryctx = document
    .getElementById("summaryChart")
    .getContext("2d");

new Chart(summaryctx, {

    type: "doughnut",

    data: {

        labels: [
            "Completed",
            "Visited",
            "Approved"
        ],

        datasets: [{

            data: [

                consultationSummary.completed,

                consultationSummary.visited,

                consultationSummary.pending

            ],

            backgroundColor: [

                "#198754",

                "#6c757d",

                "#0d6efd"

            ],

            borderWidth: 0

        }]

    },

    options: {

        responsive: true,

        cutout: "65%",

        plugins: {

            legend: 
            {
                position: "bottom",
                labels:
                                {
                                    padding: 20,
                                    usePointStyle: true,
                                    pointStyle: 'circle',
                                    font:
                                    {
                                        size: 13,
                                        weight: '600'
                                    }
                                }
            }

        }

    }

});


    </script>

</body>

</html>