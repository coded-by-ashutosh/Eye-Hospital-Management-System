<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        Assigned Patients
    </title>

    <%- include('../CDN/bootstrap.ejs') %>
        <%- include('../CDN/datatable_css.ejs') %>

</head>

<body>

    <div class="d-flex">

        <%- include('../Header/Doctor_Header.ejs') %>

            <div class="flex-grow-1 bg-light px-3 py-4 eyra-main-content">

                <div class="container-fluid">

                    <h1 class="appointments-heading fw-bold mb-1">
                    Assigned Patients
                </h1>
                <p class="text-muted mb-0">
                    View all patients assigned to you, access their medical details, and manage consultations efficiently.
                </p>

                    <div class="card eyra-table-card mt-5">

                        <div class="eyra-table-card-body">

                            <div class="table-responsive">

                                <table class="table table-hover doctor-appointments-table align-middle" id="patientsTable">

                                    <thead>

                                        <tr>

                                            <th>Patient</th>

                                            <th>Email</th>

                                            <th>Total Visits</th>

                                            <th>Last Visit</th>

                                            <th>Action</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        <% patient_record.forEach((data)=> { %>

                                            <tr>

                                                <td>

                                                    <%= data.name %>

                                                </td>

                                                <td>

                                                    <%= data.email %>

                                                </td>

                                                <td>

                                                    <span class="badge bg-danger text-light">

                                                        <%= data.total_visits %>

                                                    </span>

                                                </td>


                                            <td>
                                            
                                                <% if(data.last_visit){ %>
                                            
                                                    <span class="badge date bg-primary">
                                            
                                                        <%= data.last_visit %>
                                            
                                                    </span>
                                            
                                                    <% } else { %>
                                            
                                                        <span class="text-muted">
                                            
                                                            N/A
                                            
                                                        </span>
                                            
                                                        <% } %>
                                            
                                            </td>

                                                <td>

                                                    <a href="/doctor/view_patient/<%= data.email %>"
                                                        class="eyra-btn-view-user-sm">
                                                    <i class="bi bi-eye-fill me-1"></i>
                                                        View

                                                    </a>

                                                </td>

                                            </tr>

                                            <% }) %>

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

    </div>

    <%- include('../CDN/datatable_js.ejs') %>
        <%- include('../CDN/javascript.ejs') %>

            <script>

                $('#patientsTable').DataTable();

            </script>

</body>

</html>