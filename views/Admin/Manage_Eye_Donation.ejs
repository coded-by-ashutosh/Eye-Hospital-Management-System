<!DOCTYPE html>

<html>

<head>

    <title>

        Manage Eye Donors

    </title>

    <%- include('../CDN/bootstrap.ejs') %>
        <%- include('../CDN/datatable_css.ejs') %>

</head>

<body>

    <div class="d-flex">

        <%- include('../Header/Admin_Header.ejs') %>

            <div class="flex-grow-1 bg-light px-3 py-4 eyra-main-content">

                <div class="container-fluid">

                        <!-- <h2 class="fw-bold">
                            Manage Doctors
                        </h2> -->

                        <h1 class="manage-notifications-heading fw-bold mb-1">
                            Eye Donation Records
                        </h1>
                        <p class="text-muted mb-4">
                            Review donor registrations and maintain eye donation records efficiently.
                        </p>
                   

                    <div class="card eyra-table-card mt-5">

                        <div class="eyra-table-card-body">

                            <div class="table-responsive">

                                <table class="table table-hover eyra-notifications-table align-middle"
                                    id="eyedonors_list">

                                    <thead>

                                        <tr>

                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Mobile</th>
                                            <th>Age</th>
                                            <th>Blood Group</th>
                                            <th>Status</th>
                                            <th>Action</th>

                                        </tr>

                                    </thead>


                                    <tbody>

                                        <% donor_record.forEach( (item)=>{

                                            %>

                                            <tr>

                                                <td>

                                                    <%= item.donor_name %>

                                                </td>

                                                <td>

                                                    <%= item.email %>

                                                </td>

                                                <td>

                                                    <%= item.mobile %>

                                                </td>

                                                <td>

                                                    <%= item.age %>

                                                </td>

                                                <td>

                                                    <%= item.blood_group %>

                                                </td>

                                                <td>

                                                    <% if(item.status=="approved" ) { %>

                                                        <span class="eyra-status-completed">

                                                            Approved

                                                        </span>

                                                        <% } else if(item.status=="pending"){ %>

                                                            <span class="eyra-status-pending">

                                                                Pending

                                                            </span>
                                                        
                                                        <% } else { %>

                                                            <span class="eyra-status-cancelled">

                                                                Rejected

                                                            </span>

                                                            <% } %>

                                                </td>

                                                <td>

                                                    <div class="d-flex gap-2 flex-wrap">

                                                        <% if(item.status=="pending" ){ %>

                                                             <a href="/approve_eye_donor/<%= item.id %>"
       onclick="return confirm('Approve this eye donor registration?')"
       class="eyra-btn-unblock">

        <i class="bi bi-check-circle-fill me-1"></i>
        Approve

    </a>

      <a href="/reject_eye_donor/<%= item.id %>"
       onclick="return confirm('Reject this eye donor registration?')"
       class="eyra-btn-block">

        <i class="bi bi-slash-circle-fill me-1"></i>
        Reject

    </a>


                                                            <% } %>

                                                                <a href="/delete_eye_donor/<%= item.id %>"
                                                                        onclick="return confirm('Delete this eye donor record?')"
                                                                         class="eyra-btn-delete-user">
                                                                    <i class="bi bi-trash-fill me-1"></i>
                                                                        Delete

                                                                    </a>

                                                    </div>                                                 

                                                    </div>

                                                </td>

                                            </tr>

                                            <% }) %>

                                    </tbody>

                                </table>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
    </div>

    <%- include('../CDN/datatable_js.ejs') %>
        <%- include('../Footer/Dashboard_Footer.ejs') %>
            <%- include('../CDN/javascript.ejs') %>

                <script>
                    $('#eyedonors_list').DataTable({
                        order: [[0, 'desc']]
                    });
                </script>

</body>

</html>