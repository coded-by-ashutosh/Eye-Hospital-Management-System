<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Doctor</title>

    <%- include('../CDN/bootstrap.ejs') %>

</head>

<body>

    <div class="d-flex">

        <%- include('../Header/Admin_Header.ejs') %>

            <div class="flex-grow-1 bg-light px-3 py-4 eyra-main-content">

                <div class="container-fluid">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h1 class="manage-doctors-heading fw-bold mb-1">
                                Edit Doctor
                            </h1>

                            <p class="text-muted mb-0">
                                Manage doctor profile details, medical information, uploaded assets, and account
                                credentials.
                            </p>

                        </div>

                        <a href="/manage_doctors" class="eyra-btn-back">
                            <i class="bi bi-arrow-left me-2"></i>
                            Back
                        </a>

                    </div>

                    <div class="eyra-form-card mt-5">

                        <% if(success){ %>

                            <div class="alert alert-success alert-dismissible fade show">

                                <%= success %>

                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>

                            </div>

                            <% } %>

                                <% if(error){ %>

                                    <div class="alert alert-danger alert-dismissible fade show">

                                        <%= error %>

                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>

                                    </div>

                                    <% } %>

                                        <form action="/update_doctor" method="POST" enctype="multipart/form-data">

                                            <input type="hidden" name="id" value="<%= doctor_data.id %>">

                                            <input type="hidden" name="old_image"
                                                value="<%= doctor_data.doctor_image %>">

                                            <input type="hidden" name="old_signature"
                                                value="<%= doctor_data.doctor_signature %>">

                                            <div class="eyra-form-section">

                                                <h5>
                                                    <i class="bi bi-person-vcard-fill me-2"></i>
                                                    Doctor Information
                                                </h5>

                                            </div>

                                            <div class="row">

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Doctor Name
                                                    </label>

                                                    <input type="text" name="doctor_name"
                                                        value="<%= doctor_data.doctor_name %>" class="form-control">

                                                </div>

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Speciality
                                                    </label>

                                                    <input type="text" name="speciality"
                                                        value="<%= doctor_data.speciality %>" class="form-control">

                                                </div>

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Experience
                                                    </label>

                                                    <input type="text" name="experience"
                                                        value="<%= doctor_data.experience %>" class="form-control">

                                                </div>

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Qualification
                                                    </label>

                                                    <input type="text" name="qualification"
                                                        value="<%= doctor_data.qualification %>" class="form-control">

                                                </div>

                                                <div class="col-md-12 mb-4">

                                                    <label class="form-label">
                                                        Description
                                                    </label>

                                                    <textarea name="description" rows="4"
                                                        class="form-control"><%= doctor_data.description %></textarea>

                                                </div>
                                            </div>

                                            <div class="eyra-form-section mt-4">

                                                <h5>
                                                    <i class="bi bi-file-medical-fill me-2"></i>
                                                    Medical Profile
                                                </h5>

                                            </div>


                                            <div class="row">

                                                <div class="col-md-6 mb-4 mt-3">

                                                    <div class="eyra-preview-card">

                                                        <h6>Current Photo</h6>

                                                        <img src="/public/Doctors_Photo/<%= doctor_data.doctor_image %>"
                                                            class="eyra-preview-image">

                                                    </div>
                                                </div>

                                                <div class="col-md-6 mb-4 mt-3">

                                                    <div class="eyra-preview-card">

                                                        <h6>Current Signature</h6>

                                                        <% if(doctor_data.doctor_signature){ %>

                                                            <img src="/public/Doctors_Signature/<%= doctor_data.doctor_signature %>"
                                                                class="eyra-preview-signature">

                                                            <% } else { %>

                                                                <p class="text-muted">

                                                                    No Signature Uploaded

                                                                </p>

                                                                <% } %>

                                                    </div>

                                                </div>

                                            </div>

                                            <div class="eyra-form-section mt-4">
                                                <h5>
                                                    <i class="bi bi-cloud-arrow-up-fill me-2"></i>
                                                    Upload New Assets
                                                </h5>
                                            </div>

                                            <div class="row">

                                                <div class="col-md-6 mb-4">

                                                    <label class="form-label">

                                                        Change Doctor Image

                                                    </label>

                                                    <input type="file" name="doctor_image" class="form-control">

                                                </div>


                                                <div class="col-md-6 mb-4">

                                                    <label class="form-label">

                                                        Change Signature

                                                    </label>

                                                    <input type="file" name="doctor_signature" class="form-control"
                                                        accept="image/*">

                                                </div>

                                            </div>

                                            <div class="eyra-form-section mt-4">
                                                <h5>
                                                    <i class="bi bi-shield-lock-fill me-2"></i>
                                                    Login Credentials
                                                </h5>
                                            </div>

                                            <div class="row">

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Doctor Email
                                                    </label>

                                                    <input type="email" name="email" readonly value="<%= doctor_data.email %>"
                                                        class="form-control">

                                                </div>

                                            </div>

                                            <div class="text-end mt-4">
                                                <button type="submit" class="eyra-btn-add-doctor">
                                                    <i class="bi bi-check-circle-fill me-2"></i>
                                                    Update Doctor
                                                </button>
                                            </div>
                                        </form>

                    </div>

                </div>

            </div>

    </div>


    <%- include('../Footer/Dashboard_Footer.ejs') %>
        <%- include('../CDN/javascript.ejs') %>

</body>

</html>