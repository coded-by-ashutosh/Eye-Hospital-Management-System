<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        Treatment History
    </title>

    <%- include('CDN/bootstrap.ejs') %>
        <%- include('CDN/datatable_css.ejs') %>

</head>

<body>

    <div class="d-flex">

        <%- include('Header/Patient_Header.ejs') %>

            <div class="flex-grow-1 bg-light px-3 py-4 eyra-main-content">

                <div class="container-fluid mb-4">

                    <h1 class="appointments-heading fw-bold mb-2">

                        Medical History

                    </h1>

                    <p class="text-muted mb-0">

                        View your previous consultations, diagnoses and follow-up records

                    </p>

                </div>

                <div class="card eyra-table-card mt-5">

                    <div class="eyra-table-card-body">

                        <% if(medical_record.length>0) { %>

                            <div class="table-responsive">

                                <table class="table table-hover eyra-appointment-table align-middle" id="medicalTable">

                                    <thead>

                                        <tr>

                                            <!-- <th>#</th> -->
                                            <th>Visit Date</th>
                                            <th>Doctor</th>
                                            <th>Issue</th>
                                            <th>Diagnosis</th>
                                            <th>Status</th>
                                            <th>Next Visit</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        <% medical_record.forEach((data)=> { %>

                                            <tr>

                                                <!-- <td>

                                                    <%= data.id %>

                                                </td> -->

                                                <td>
                                                    <span class="badge date bg-primary">
                                                    <%= new Date(data.preferred_date).toISOString().split('T')[0] %>
                                                    </span>
                                                </td>

                                                <td>

                                                    <div>

                                                        <h6 class="mb-0">

                                                            <%= data.doctor_name || 'Not Assigned' %>

                                                        </h6>

                                                        <small class="text-muted">

                                                            <%= data.speciality || '' %>

                                                        </small>

                                                    </div>

                                                </td>

                                                <td>

                                                    <%= data.issue %>

                                                </td>

                                                <td>

                                                    <%= data.diagnosis || 'Not Available' %>

                                                </td>

                                                <td>

                                                    <% if(data.status=="Completed" ) { %>

                                                        <span class="eyra-status-completed">
                    
                      Completed
                    
                    </span>

                                                        <% } else if(data.status=="Approved" ) { %>

                                                            <span class="eyra-status-approved">
                      
                        Approved
                      
                      </span>

                                                            <% } else if(data.status=="Pending" ) { %>

                                                                <span class="eyra-status-pending">
                        
                          Pending
                        
                        </span>

                                                                <% } else if(data.status=="Visited" ) { %>

                                                                    <span class="eyra-status-visited">
                          
                            Visited
                          
                          </span>

                                                                    <% } else { %>

                                                                       <span class="eyra-status-cancelled">
                            
                              Rejected
                            
                            </span>
                

                                                                        <% } %>

                                                </td>

                                                <td>
                                                
                                                    <% if(data.next_visit_date) { %>
                                                        <span class="badge date bg-primary">
                                                        <%= new Date(data.next_visit_date).toISOString().split('T')[0] %>
                                                        </span>
                                                            <% } else { %>
                                                
                                                                <span class="text-muted">
                                                
                                                                    Not Scheduled
                                                
                                                                </span>
                                                
                                                                <% } %>
                                                
                                                </td>

                                            </tr>

                                            <% }) %>

                                    </tbody>

                                </table>

                            </div>

                            <% } else { %>

                                <div class="text-center py-5">

                                    <p class="appointment-text text-muted mb-3">

                                        No medical records available yet

                                    </p>

                                </div>

                                <% } %>

                    </div>

                </div>

            </div>

    </div>

    </div>


    <%- include('chat/chat.ejs') %>
        <%- include('CDN/datatable_js.ejs') %>
            <%- include('CDN/javascript.ejs') %>

                <script>

                    $('#medicalTable').DataTable({
                        order: [[0, 'desc']]
                    });
                </script>

</body>

</html>